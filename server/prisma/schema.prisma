generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================
// Approval Status Enum
// ===========================

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  fan
  coach
}

enum MembershipPlan {
  rookie
  veteran
  legend
}

enum CoachApplicationStatus {
  submitted
  approved
  rejected
  superseded
}

// ===========================
// Ad Enums
// ===========================

enum AdStatus {
  draft
  pending
  active
  approved
  rejected
  archived
}

enum AdPaymentStatus {
  unpaid
  pending_approval
  hold
  paid
  refund_pending
  refunded
  // Terminal state for a rejected Apple-IAP-paid ad — the server can't issue an
  // Apple refund, so ops process it out of band; keeps the ad out of the
  // refund_pending reconcile sweep so it stops re-alarming. Audit 2026-07-14.
  manual_refund_review
}

enum AdBannerModerationStatus {
  clean
  flagged
  error
}

// ===========================
// Team Membership Enums
// ===========================

enum TeamRole {
  owner
  manager
  coach
  assistant_coach
  player
  parent
  member
  equipment
  health_wellness
}

enum TeamStatus {
  active
  archived
}

enum MembershipStatus {
  active
  invited
  archived
}

enum TeamLevel {
  varsity
  jv
  freshman
  middle_school
  unified
  other
}

enum TeamGender {
  boys
  girls
  coed
}

enum OrganizationRole {
  owner
  manager
  member
  coach
}

enum OrganizationStatus {
  active
  rejected
}

enum OrganizationJoinRequestStatus {
  pending
  approved
  denied
}

// ===========================
// Team Invite Enums
// ===========================

enum InviteStatus {
  pending
  accepted
  declined
  revoked
}

// ===========================
// Event Enums
// ===========================

enum EventStatus {
  draft
  approved
  rejected
  cancelled
}

enum EventApprovalStatus {
  pending
  approved
  rejected
}

// ===========================
// Pro Sports Enums
// ===========================

// Professional leagues whose schedules VarsityHub surfaces as fan-postable
// event pages. See docs/superpowers/specs/2026-07-23-pro-sports-events-design.md.
enum ProLeague {
  nfl
  nba
  wnba
  mlb
  wwe
  ufc
  atp
  wta
  ncaaf
  ncaamb
  ncaawb
  ncaabaseball
  ncaamhockey
}

// ===========================
// Game Enums
// ===========================

enum GameApprovalStatus {
  approved
  pending
  rejected
}

// Opponent-approval workflow (2026-07-06): when a coach links a real
// VarsityHub team as opponent that they do NOT manage, the game only becomes
// publicly visible once that opponent team's staff confirms it. Independent
// of GameApprovalStatus, which is the platform moderation gate.
enum OpponentApprovalStatus {
  not_required
  pending
  approved
  declined
}

// ===========================
// Minors / Parental Consent
// ===========================

// Parental consent state for users aged 13–17. For adults (18+) and unknown-age
// users, the value is `not_required`. The actual consent-gathering flow lives
// in a later pass; this enum exists now so every consumer can read a canonical
// field instead of probing preferences JSON.
enum ParentalConsentStatus {
  not_required
  pending
  approved
  denied
}

// ===========================
// Core Models
// ===========================

model User {
  id                         String    @id @default(cuid())
  email                      String    @unique @db.VarChar(320)
  password_hash              String?
  google_id                  String?   @unique
  apple_id                   String?   @unique
  display_name               String?   @db.VarChar(120)
  username                   String?   @unique @db.VarChar(20)
  avatar_url                 String?   @db.VarChar(2048)
  bio                        String?   @db.VarChar(300)
  created_at                 DateTime  @default(now())
  email_verified             Boolean   @default(false)
  email_verification_code    String?
  email_verification_expires DateTime?
  password_reset_code        String?
  password_reset_expires     DateTime?
  password_changed_at        DateTime? @default(now())
  // Monotonic counter bumped on every successful login / password reset.
  // The value is embedded as `se` in access-token JWTs; middleware rejects
  // tokens whose `se` doesn't match the current value, which enforces the
  // "only one active session per user" rule: a new login invalidates every
  // prior access token and refresh token family immediately.
  session_epoch              Int       @default(0)
  banned                     Boolean   @default(false)
  ban_reason                 String?   @db.Text
  banned_until               DateTime?
  preferences                Json      @default("{}")

  // ── Canonical auth / onboarding state (replaces hot-path JSON reads) ──
  role                        UserRole  @default(fan)
  onboarding_completed        Boolean   @default(false)
  organization_id             String?
  proceeding_as_fan           Boolean   @default(false)
  coach_agreement_accepted_at DateTime?
  coach_agreement_version     Int?
  terms_accepted_at           DateTime?
  terms_version               Int?

  // ── Canonical billing/onboarding state (replaces payment JSON reads) ──
  plan             MembershipPlan  @default(rookie)
  pending_plan     MembershipPlan?
  payment_pending  Boolean         @default(false)
  payment_approved Boolean         @default(false)

  // ── Canonical date of birth (replaces preferences.dob) ──
  // Stored as DATE, not DATETIME, because the relevant precision is day-level.
  // `dob_set_at` records when the field was first populated so the 24-hour
  // grace-window (typo correction) can be enforced by route handlers without
  // another round-trip. After the grace window, only admins may change the DOB.
  date_of_birth DateTime? @db.Date
  dob_set_at    DateTime?

  // ── Parental consent (13–17 only; enum default handles everyone else) ──
  // `parent_email` is captured at signup / first minor detection. The actual
  // consent-verification flow is a follow-up; these fields exist now so the
  // data model doesn't have to churn again when the flow lands.
  parent_email                  String?               @db.VarChar(320)
  parental_consent_status       ParentalConsentStatus @default(not_required)
  parental_consent_at           DateTime?
  // When the parent was emailed (starts the 14-day expiry clock). Null outside
  // an active consent request.
  parental_consent_requested_at DateTime?
  // SHA-256 hash of the single-use consent-link token. Storing the hash (not
  // the raw token) matches the pattern used for refresh_token and password
  // reset codes — a DB leak doesn't expose active consent links.
  parental_consent_token_hash   String?               @db.VarChar(128)

  // ── Account deletion (soft-delete + anonymize) ──
  // Self-serve deletion anonymizes PII immediately and sets `deleted_at`; a
  // scheduled job hard-deletes the row after the retention window (to preserve
  // downstream referential integrity in the meantime).
  deleted_at          DateTime?
  deletion_anonymized Boolean   @default(false)

  // Coach approval status — APPROVED for fans, PENDING for new coaches until league owner approves
  approval_status  ApprovalStatus @default(APPROVED)
  // v1.0.2: 48hr cooldown tracking for rejected coach/org applications
  rejected_at      DateTime?
  rejection_reason String?        @db.Text

  // Subscription/Premium fields
  subscription_tier       String    @default("free") // free | premium | pro
  subscription_status     String    @default("active") // active | cancelled | expired
  subscription_expires_at DateTime?
  stripe_customer_id      String?   @unique
  max_teams               Int       @default(4) // Rookie/free users get 4 teams
  paid_by_owner           Boolean   @default(false) // true if coach's plan is covered by league owner

  // Relations
  refreshTokens     RefreshToken[]
  coachApplications CoachApplication[]        @relation("coach_applicant")
  memberships       TeamMembership[]
  orgMemberships    OrganizationMembership[]
  orgJoinRequests   OrganizationJoinRequest[]
  teamJoinRequests  TeamJoinRequest[]
  organization      Organization?             @relation("user_active_organization", fields: [organization_id], references: [id], onDelete: SetNull)
  rsvps             EventRsvp[]
  createdEvents     Event[]
  stories           Story[]
  postingUnlocks    EventPostingUnlock[]
  ads               Ad[]
  posts             Post[]
  categoryFollows   CategoryFollow[]
  promoRedemptions  PromoRedemption[]
  transactionLogs   TransactionLog[]

  // Follows (self-relation)
  following           Follows[]            @relation("following")
  followers           Follows[]            @relation("followers")
  teamFollows         TeamFollow[]
  organizationFollows OrganizationFollow[]
  program_follows     ProgramFollow[]
  proTeamFollows      ProTeamFollow[]

  // Messages
  messagesSent     Message[]      @relation("message_sender")
  messagesReceived Message[]      @relation("message_recipient")
  Comment          Comment[]
  postUpvotes      PostUpvote[]
  postBookmarks    PostBookmark[]
  gameVotes        GameVote[]
  eventVotes       EventVote[]
  pollVotes        PollVote[]

  // Blocking
  blocking  BlockedUser[] @relation("blocker")
  blockedBy BlockedUser[] @relation("blocked")

  // Group Chats
  createdGroupChats    GroupChat[]
  groupChatMemberships GroupChatMember[]
  groupChatMessages    GroupChatMessage[]

  // Notifications
  notifications Notification[] @relation("notification_user")
  actions       Notification[] @relation("notification_actor")

  // Games (approval workflow)
  createdGames          Game[] @relation("created_games")
  approvedGames         Game[] @relation("approved_games")
  opponentApprovedGames Game[] @relation("opponent_approved_games")

  // League ownership (organizations this user owns)
  ownedOrganizations Organization[] @relation("league_owner")

  // Abuse Reports
  abuseReports AbuseReport[]

  // Warnings/Strikes
  warnings       UserWarning[] @relation("warned_user")
  issuedWarnings UserWarning[] @relation("warning_issuer")

  // Parental consent audit trail (admin override history)
  parentalConsentAuditsAsSubject ParentalConsentAudit[] @relation("consent_audit_user")
  parentalConsentAuditsAsActor   ParentalConsentAudit[] @relation("consent_audit_actor")

  dataExports DataExport[]

  @@index([subscription_status])
  @@index([banned])
  @@index([email_verified])
  @@index([approval_status])
  @@index([display_name])
  @@index([deleted_at])
  @@index([parental_consent_status])
  @@index([role])
  @@index([organization_id])
}

// GDPR / right-to-access self-serve data export.
//
// Users request an export via POST /me/data-export, a worker builds a ZIP of
// their owned/authored data into S3-compatible storage, and the user
// downloads via a short-lived signed URL. Archives expire after
// DATA_EXPORT_RETENTION_DAYS (default 7) — the cleanup cron then deletes
// the object and flips `status` to `expired`, keeping the row as a
// metadata-only audit record.
//
// Status flow:
//   pending  → building → ready → expired
//                       → failed
model DataExport {
  id                 String    @id @default(cuid())
  user_id            String
  status             String // pending | building | ready | expired | failed
  requested_at       DateTime  @default(now())
  started_at         DateTime?
  completed_at       DateTime?
  expires_at         DateTime?
  // Storage backend key/path (e.g. S3 object key). Null before build and
  // after expiry cleanup. Never contains PII.
  storage_key        String?
  size_bytes         Int?
  // Coarse error category only — no raw stack or message. Keeps the row
  // safe to log/surface to admins.
  error_category     String?
  download_count     Int       @default(0)
  last_downloaded_at DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, requested_at])
  @@index([status, requested_at])
}

// Parental consent admin-override audit trail. Append-only: every admin
// override (approve/deny/reset) writes a new row. Use for COPPA compliance
// records — never UPDATE or DELETE rows here.
model ParentalConsentAudit {
  id             String                @id @default(cuid())
  user_id        String
  actor_admin_id String
  from_state     ParentalConsentStatus
  to_state       ParentalConsentStatus
  reason         String                @db.Text
  created_at     DateTime              @default(now())

  user        User @relation("consent_audit_user", fields: [user_id], references: [id], onDelete: Cascade)
  actor_admin User @relation("consent_audit_actor", fields: [actor_admin_id], references: [id], onDelete: Restrict)

  @@index([user_id, created_at])
  @@index([actor_admin_id, created_at])
}

model RefreshToken {
  id                 String    @id @default(cuid())
  // v1: SHA-256 hex of the full raw token (deterministic, used for lookup).
  // v2: bcrypt of the secret half of `<keyId>.<secret>` (verification only;
  //     lookup goes through `key_id` instead).
  token_hash         String    @unique
  // v2 only: deterministic 16-char hex prefix used to look up the row.
  // Null for legacy v1 rows; required + unique going forward.
  key_id             String?   @unique
  // 1 = legacy SHA-256-of-raw, 2 = `<keyId>.<bcrypt(secret)>` scheme.
  // Default 1 covers existing rows on migration day; the write path always
  // sets 2 for new tokens.
  hash_version       Int       @default(1)
  user_id            String
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device_info        String? // User-Agent or device identifier
  expires_at         DateTime
  created_at         DateTime  @default(now())
  last_used_at       DateTime  @default(now())
  // Rotation supersede metadata (additive, nullable — existing rows read as
  // "never rotated" and behave exactly as before). On rotation the old row is
  // marked rotated instead of deleted, so a slow/aborted /auth/refresh that
  // retries with the just-rotated token can be served from a short grace
  // window instead of tripping the reuse/theft revoke-all path.
  rotated_at         DateTime? // when this token was superseded by a newer one
  replaced_by_key_id String? // key_id of the token that superseded this one

  @@index([user_id])
  @@index([expires_at])
}

model Game {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(200)
  date      DateTime
  // IANA timezone captured from the creator's device at create time, so
  // server-rendered emails can show the correct local time (audit 2026-07-14).
  timezone  String?  @db.VarChar(64)
  location  String?
  latitude  Float?
  longitude Float?

  // New: Team relationships
  home_team_id String?
  away_team_id String?
  homeTeam     Team?   @relation("home_games", fields: [home_team_id], references: [id], onDelete: SetNull)
  awayTeam     Team?   @relation("away_games", fields: [away_team_id], references: [id], onDelete: SetNull)

  // Team names for display (backward compatibility)
  home_team      String?
  away_team      String?
  away_team_name String?

  // Venue information
  venue_place_id String?
  venue_address  String?
  venue_lat      Float?
  venue_lng      Float?
  is_neutral     Boolean @default(false)

  description         String?
  cover_image_url     String?
  banner_url          String?
  // Optional appearance/preset for the match banner (e.g. classic, sparkle, sporty)
  appearance          String?
  // Expected attendance for events (optional)
  expected_attendance Int?
  // Event type: game, fundraiser, watch_party, team_trip, meeting, other
  event_type          String? @default("game")

  // Event type-specific fields
  donation_goal           Float? // For fundraisers - target amount
  watch_location          String? @db.VarChar(200) // For watch parties - viewing location
  watch_location_lat      Float? // Watch party location latitude
  watch_location_lng      Float? // Watch party location longitude
  watch_location_place_id String? // Google Places ID for watch location
  destination             String? @db.VarChar(200) // For team trips - destination city/venue

  // Approval workflow
  approval_status GameApprovalStatus @default(approved)
  created_by_id   String?
  created_by      User?              @relation("created_games", fields: [created_by_id], references: [id], onDelete: SetNull)
  approved_by_id  String?
  approved_by     User?              @relation("approved_games", fields: [approved_by_id], references: [id], onDelete: SetNull)
  approved_at     DateTime?

  // Opponent-approval workflow — see OpponentApprovalStatus above.
  opponent_approval_status  OpponentApprovalStatus @default(not_required)
  opponent_approval_team_id String?
  opponent_approved_by_id   String?
  opponent_approved_by      User?                  @relation("opponent_approved_games", fields: [opponent_approved_by_id], references: [id], onDelete: SetNull)
  opponent_approved_at      DateTime?
  opponent_declined_reason  String?                @db.VarChar(2000)

  // Game result (set by coaches/owners via PATCH /games/:id/result)
  home_score Int? // Home team score
  away_score Int? // Away team score
  winner     String? // "home" | "away" | "tie" | null if not yet played

  created_at DateTime @default(now())

  // Back-relations
  posts   Post[]
  stories Story[]
  events  Event[]
  votes   GameVote[]

  @@index([date])
  @@index([latitude, longitude])
  @@index([home_team_id])
  @@index([away_team_id])
  @@index([approval_status])
  @@index([approval_status, date])
  @@index([approval_status, created_at])
  @@index([opponent_approval_status])
  @@index([opponent_approval_team_id, opponent_approval_status])
}

model Post {
  id String @id @default(cuid())
  client_request_hash String?

  author_id String
  author    User   @relation(fields: [author_id], references: [id], onDelete: Cascade)

  title         String? @db.VarChar(200)
  content       String? @db.VarChar(4000)
  type          String? @db.VarChar(50) // consider enum later
  media_url     String?
  // Batch media (PDF commandments: "up to 5 items per post"). media_url stays
  // the first/primary item for backward compat with existing rows and older
  // clients that only ever send a single media_url; media_urls additionally
  // holds the full ordered list (including the first) when a post has more
  // than one item. Empty for text-only or single-media posts created before
  // this field existed — always read media_url as the fallback single item.
  media_urls    String[] @default([])
  upvotes_count Int     @default(0)

  // Media metadata captured at upload (from the Cloudinary response today; from
  // the client for a future direct-to-storage provider). All nullable/additive
  // — every existing row is null. media_width/height/duration_s power correct
  // pre-load aspect ratios; media_bytes + duration feed cost/integrity tooling
  // for a storage migration. poster_url is the provider-independence seam: when
  // set (e.g. a poster uploaded alongside a non-Cloudinary video) the serializer
  // serves it as preview_url instead of deriving a Cloudinary transform.
  poster_url       String?
  media_width      Int?
  media_height     Int?
  media_duration_s Float?
  media_bytes      Int?

  // Geolocation (optional)
  country_code String?
  admin1       String?
  lat          Float?
  lng          Float?

  game_id String?
  game    Game?   @relation(fields: [game_id], references: [id], onDelete: SetNull)

  // Direct event link. Posts attach to an event either via this column (event
  // pages that have no linked game) or via game_id (events backed by a game).
  // Required for the open-ended post-event upload window to work on event-only
  // pages — the grace check looks for a prior live-window post by event_id OR game_id.
  event_id String?
  event    Event?  @relation(fields: [event_id], references: [id], onDelete: SetNull)

  team_id   String?
  team      Team?   @relation(fields: [team_id], references: [id], onDelete: SetNull)
  is_pinned Boolean @default(false)

  created_at DateTime  @default(now())
  deleted_at DateTime?

  poll Poll?

  comments      Comment[]
  upvotes       PostUpvote[]
  bookmarks     PostBookmark[]
  categories    CategoryAssignment[]
  notifications Notification[]

  @@index([created_at])
  @@index([author_id])
  // Profile hot path: `where { author_id, deleted_at: null } orderBy created_at desc`.
  // @@index([author_id]) alone can't serve the deleted_at filter or the sort, so the
  // post list AND its count both scanned every row by this author and sorted in memory.
  @@index([author_id, deleted_at, created_at])
  @@index([game_id, created_at])
  @@index([game_id, type])
  @@index([team_id])
  @@index([team_id, is_pinned])
  @@index([deleted_at, created_at])
  @@index([country_code, upvotes_count])
  // Composite index for /highlights queries that filter by country_code,
  // sort by upvotes_count desc, then break ties by created_at desc, and
  // paginate with `take`. Without this, Postgres scans every row in the
  // country bucket and sorts in memory before applying limit. With 500-row
  // takes per highlight call and 5+ findMany calls per request, that was
  // the dominant DB cost on feed mount.
  @@index([country_code, upvotes_count, created_at])
  // Highlights feed: WHERE deleted_at IS NULL AND country_code = X AND media_url IS NOT NULL
  // Partial index not supported in Prisma schema DSL; this covers the most selective columns.
  @@index([country_code, deleted_at, upvotes_count, created_at])
  @@index([type, created_at])
  @@index([event_id, created_at])
}

// Durable owner-bound direct upload checkpoint. No credentials are stored here.
model MediaUpload {
  id String @id
  owner_id String
  content_type String
  expected_bytes Int
  public_id String @unique
  state String @default("uploading")
  result Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  @@index([owner_id, created_at])
  @@index([state, created_at])
}

model Poll {
  id         String       @id @default(cuid())
  post_id    String       @unique
  post       Post         @relation(fields: [post_id], references: [id], onDelete: Cascade)
  options    PollOption[]
  created_at DateTime     @default(now())
  expires_at DateTime?
}

model PollOption {
  id          String     @id @default(cuid())
  poll_id     String
  poll        Poll       @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  text        String
  votes       PollVote[]
  votes_count Int        @default(0)

  @@index([poll_id])
}

model PollVote {
  id             String     @id @default(cuid())
  poll_option_id String
  poll_option    PollOption @relation(fields: [poll_option_id], references: [id], onDelete: Cascade)
  user_id        String
  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at     DateTime   @default(now())

  @@unique([poll_option_id, user_id])
  @@index([user_id])
}

model Event {
  id         String      @id @default(cuid())
  title      String      @db.VarChar(200)
  date       DateTime
  // IANA timezone from the creator's device (audit 2026-07-14) — lets emails
  // render the correct local time instead of the server's UTC.
  timezone   String?     @db.VarChar(64)
  location   String?     @db.VarChar(500)
  latitude   Float?
  longitude  Float?
  banner_url String?
  game_id    String?
  status     EventStatus @default(draft)
  capacity   Int?
  created_at DateTime    @default(now())

  // Fan event creation fields
  creator_id      String?
  creator_role    String?             @db.VarChar(50) // fan, coach, organizer
  approval_status EventApprovalStatus @default(pending)
  event_type      String?             @db.VarChar(50) // game, watch_party, fundraiser, tryout, bbq, other
  description     String?             @db.VarChar(5000)
  linked_league   String?             @db.VarChar(255) // League/school name or ID
  max_attendees   Int?
  contact_info    String?             @db.VarChar(500)
  approved_by     String? // User ID of approver
  approved_at     DateTime?
  rejected_reason String?

  // Team association — fan pitches must be tied to a team
  team_id String?
  team    Team?   @relation(fields: [team_id], references: [id], onDelete: SetNull)

  // ── Pro sports (2026-07-23) ──────────────────────────────────────────────
  // A professional fixture is an Event, never a Game: Game carries scores,
  // GameVote, and the shared-game authority model, none of which we want to
  // own for the NBA. VarsityHub stores no pro scores. Both team ids are
  // nullable — WWE and other touring shows have a venue but no two-team
  // matchup, so they ride this path with both left null.
  pro_home_team_id String?
  pro_away_team_id String?
  proHomeTeam      ProTeam? @relation("pro_home_events", fields: [pro_home_team_id], references: [id], onDelete: SetNull)
  proAwayTeam      ProTeam? @relation("pro_away_events", fields: [pro_away_team_id], references: [id], onDelete: SetNull)

  // Stable upstream key (`{league}:{provider-game-id}`) making schedule
  // ingestion idempotent: a re-run updates a postponed or relocated fixture in
  // place instead of inserting a duplicate event page.
  pro_external_ref String? @unique @db.VarChar(200)

  // Data-driven league metadata layer. Nullable during migration so existing
  // VarsityHub-created events and legacy pro/NCAA rows continue to work while
  // schedule coverage moves away from the fixed ProLeague enum.
  sports_league_id String?
  sportsLeague     SportsLeague? @relation(fields: [sports_league_id], references: [id], onDelete: SetNull)

  // Exclusive poster (owner one-off feature, 2026-07-14): when set, ONLY this
  // user may post to this event — every other user (even attendees who were
  // there) is blocked. Null = normal multi-fan posting. Plain id column (no FK
  // relation) to avoid a second User back-relation; the posting gate compares
  // ids directly. A designation for a since-deleted user simply means nobody
  // matches, so nobody can post (acceptable for this rare state).
  exclusive_poster_id String?

  // Owner rule (2026-07-15): the default geofenced live post window is -1h →
  // +3h around event start. All-day festivals (Fanatics Fest) override the
  // hours-after-start bound per event (18 for the fest days). Null = default
  // (3h). Only the after-start bound is overridable; the window always opens
  // 1 hour before start.
  live_window_hours_after_start Int?

  game              Game?                   @relation(fields: [game_id], references: [id], onDelete: SetNull)
  creator           User?                   @relation(fields: [creator_id], references: [id], onDelete: SetNull)
  rsvps             EventRsvp[]
  posts             Post[]
  stories           Story[]
  votes             EventVote[]
  postingUnlocks    EventPostingUnlock[]
  designatedPosters EventDesignatedPoster[]

  @@index([date])
  @@index([game_id])
  @@index([latitude, longitude])
  @@index([creator_id])
  @@index([creator_id, created_at])
  @@index([approval_status])
  @@index([approval_status, status, date])
  @@index([event_type])
  @@index([status])
  @@index([team_id])
  @@index([exclusive_poster_id])
  @@index([pro_home_team_id, date])
  @@index([pro_away_team_id, date])
  @@index([sports_league_id])
}

