  activeUsers     User[]  @relation("user_active_organization")

  // Contact info (optional)
  contact_info String? @db.VarChar(500)

  // Supporting document (file/image) URL — required for new org creation
  supporting_document_url String? @db.VarChar(2000)

  teams          Team[]
  memberships    OrganizationMembership[]
  invites        OrganizationInvite[]
  joinRequests   OrganizationJoinRequest[]
  followers      OrganizationFollow[]
  sport_programs SportProgram[]

  @@index([name])
  @@index([zip_code])
  @@index([location])
  @@index([league_owner_id])
  @@index([admin_approved])
  @@index([status])
}

