// Durable "was there" ledger for location-based event posting (owner rule,
// 2026-07-15 Fanatics Fest punch list): a user's FIRST geofence-passing post
// or story to an event page writes a row here; for 7 days after unlocked_at
// they may keep uploading to that event page without re-passing the geofence.
// A dedicated table (not a Post/Story lookup) because Story rows expire and
// are deleted after 24h, and users can delete their posts — the proof of
// presence must outlive the content that earned it.
model EventPostingUnlock {
  user_id     String
  event_id    String
  unlocked_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@id([user_id, event_id])
  @@index([event_id])
}

// Additive designated-poster allowlist (owner rule, 2026-07-19 Fanatics Fest):
// a user granted a row here may post AND upload stories to the event page at
// any time, from anywhere — bypassing the live window and venue geofence —
// WITHOUT blocking any other user. This is the deliberate post-event "give a
// specific person continued access for marketing/continuity" grant. Contrast
// Event.exclusive_poster_id, which is single-user and blocks everyone else.
// Many-to-many (an event can have several designated posters; a user can be
// designated on several events). `user_id` is a plain column (no back-relation
// on User, mirroring exclusive_poster_id) — a grant for a since-deleted user
// simply never matches. Rows cascade-delete with their event.
model EventDesignatedPoster {
  event_id   String
  user_id    String
  created_at DateTime @default(now())
  created_by String? // admin/owner who granted the access (audit trail)

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@id([event_id, user_id])
  @@index([user_id])
}

model Message {
  id              String  @id @default(cuid())
  conversation_id String?

  sender_id    String
  recipient_id String?

  sender        User           @relation("message_sender", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient     User?          @relation("message_recipient", fields: [recipient_id], references: [id], onDelete: SetNull)
  notifications Notification[]

  content    String?  @db.VarChar(5000)
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([created_at])
  @@index([sender_id, created_at])
  @@index([recipient_id, created_at])
  @@index([recipient_id, read])
  @@index([conversation_id])
  // Speeds up the conversation-pair lookup in messages.ts:114-119 which filters
  // `(sender_id = me AND recipient_id = other) OR (sender_id = other AND recipient_id = me)`.
  // A B-tree on (sender_id, recipient_id) handles both directions because both
  // clauses are equality predicates over the same two columns.
  @@index([sender_id, recipient_id])
}

