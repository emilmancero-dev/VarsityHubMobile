  location            String?            @db.VarChar(500) // City, State format
  zip_code            String?            @db.VarChar(20) // For nearby search
  season_start        DateTime?
  season_end          DateTime?
  status              OrganizationStatus @default(active)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @default(now()) @updatedAt

  // Super admin approval — every league page owner must be approved by emancero@varsityhub.app
  admin_approved   Boolean   @default(false)
  approved_by      String? // super admin user ID who approved
  approved_at      DateTime?
  // v1.0.2: 48hr cooldown tracking when an org application is rejected
  rejected_at      DateTime?
  rejection_reason String?   @db.Text

  // League owner — the user who owns/pays for this league page
