  memberships  TeamMembership[]
  invites      TeamInvite[]
  joinRequests TeamJoinRequest[]
  followers    TeamFollow[]
  groupChats   GroupChat[]
  posts        Post[]

  // Game relations
  homeGames Game[] @relation("home_games")
  awayGames Game[] @relation("away_games")

  // Event relations (fan pitches tied to team)
  events Event[]

  @@index([name])
  @@index([city, state])
  @@index([sport])
  @@index([organization_id])
  @@index([is_private])
  @@index([program_id])
}

model Organization {
  id                  String             @id @default(cuid())
