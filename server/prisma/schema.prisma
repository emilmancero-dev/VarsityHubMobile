  logo_url                 String?
  avatar_url               String?
  sport                    String?     @db.VarChar(100)
  club_type                String      @default("sport") // "sport" or "extracurricular"
  extracurricular_category String?     @db.VarChar(100) // theater | chess | debate | robotics | band | student_government | academic_decathlon | etc.
  season                   String?     @db.VarChar(50) // "Fall" | "Spring" | "Winter" | "Summer"
  level                    TeamLevel?
  gender                   TeamGender?
  program_id               String?
  primary_color            String?     @db.VarChar(20) // hex color for team branding
  season_start             DateTime?
  season_end               DateTime?
  organization_id          String
  status                   TeamStatus  @default(active)
  // When true, the team is hidden from public search and discover. Only team
  // members, followers, and org admins (owner/manager) can list the roster
  // or pull the full profile. Set via the team-update endpoint by team staff
  // or org admins.
  is_private               Boolean     @default(false)

