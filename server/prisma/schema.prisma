model Story {
  id String @id @default(cuid())
  client_request_hash String?

  // A story hangs off EITHER a game OR an event page. Games carry scores; pro
  // and other game-less event pages don't, so their stories key on event_id.
  // Exactly one of game_id / event_id is set (enforced in the create handlers).
  // game_id stays nullable-not-required so existing game stories are untouched.
  game_id  String?
  event_id String?
  user_id  String?

  media_url  String
  // Still poster for video stories (esp. R2-hosted, which have no
  // server-derivable thumbnail). Generated lazily via Cloudinary upload-by-URL.
  poster_url String?
  caption    String?   @db.VarChar(500)
  created_at DateTime  @default(now())
  expires_at DateTime? // 24h after created_at; expired stories are filtered out

  // Geolocation (optional)
  lat Float?
  lng Float?

  game  Game?  @relation(fields: [game_id], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([game_id, created_at])
  @@index([expires_at])
  // Speeds up the per-game lazy-expiry sweep in gameStories.ts (`deleteMany WHERE
  // game_id = X AND expires_at < now()`) — existing (game_id, created_at) and
  // (expires_at) alone force a scan through every story for the game.
  @@index([game_id, expires_at])
  // Same access patterns for event-page stories (list + lazy-expiry sweep).
  @@index([event_id, created_at])
  @@index([event_id, expires_at])
  @@index([lat, lng])
}

