  business_name              String?                   @db.VarChar(200)
  banner_url                 String?                   @db.VarChar(2048)
  banner_fit_mode            String?                   @default("fill") // cover | contain | fill (CSS object-fit)
  target_url                 String?                   @db.VarChar(2048) // URL to open when ad is clicked
  cta_text                   String?                   @db.VarChar(50) // Advertiser-chosen CTA button label, e.g. "Learn More"
  target_zip_code            String?                   @db.VarChar(12)
  target_lat                 Float? // Latitude of target_zip_code (populated on create/update)
  target_lng                 Float? // Longitude of target_zip_code (populated on create/update)
  radius                     Int                       @default(45) // non-null with default
  description                String?                   @db.VarChar(1000)
  status                     AdStatus                  @default(draft)
  payment_status             AdPaymentStatus           @default(unpaid)
  admin_note                 String?                   @db.VarChar(2000) // Note from admin when approving/rejecting
  impression_count           Int                       @default(0)
  click_count                Int                       @default(0)
  last_impression_at         DateTime?
  last_click_at              DateTime?
  banner_moderation_status   AdBannerModerationStatus?
  banner_moderation_labels   Json?
  banner_moderation_score    Float?
