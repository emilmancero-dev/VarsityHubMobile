// ===========================
// Transaction Logging
// ===========================

enum TransactionType {
  AD_PURCHASE
  AD_DELETED
  SUBSCRIPTION_PURCHASE
  SUBSCRIPTION_RENEWAL
  SUBSCRIPTION_RENEWAL_FAILED
  SUBSCRIPTION_CANCEL
  APPLE_S2S_NOTIFICATION
  REFUND
  PROMO_REDEMPTION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  RECEIVED
  REFUNDED
  CANCELLED
  // Payment ingested but a downstream side effect (session re-verify,
  // promo redemption, etc.) failed. Surfaced on the admin dashboard for
  // manual reconciliation instead of being dropped or mis-labeled FAILED.
  NEEDS_REVIEW
}

model TransactionLog {
  id String @id @default(cuid())

  // Transaction identification
  transaction_type         TransactionType
  status                   TransactionStatus @default(PENDING)
  stripe_session_id        String?           @unique
  stripe_payment_intent_id String?
  stripe_subscription_id   String?
  // v1.0.2: Apple IAP transaction identifier. @unique closes the TOCTOU window in
  // server/src/routes/payments.ts where two rapid replays could both pass the findFirst check.
  // Old rows have NULL; new IAP writes populate this. Never set for Stripe flows.
  apple_transaction_id     String?           @unique

  // User and order details
  user_id    String?
  user_email String?
  order_id   String? // Ad ID, subscription ID, etc.

  // Financial details (all in cents)
  subtotal_cents   Int @default(0)
  tax_cents        Int @default(0)
  stripe_fee_cents Int @default(0)
  discount_cents   Int @default(0)
  total_cents      Int @default(0)
  net_cents        Int @default(0) // total - stripe_fee

  // Promo code tracking
  promo_code           String?
  promo_discount_cents Int     @default(0)

  // Metadata
  currency       String  @default("usd")
  payment_method String? // "card", "bank_transfer", etc.
  metadata       Json? // Additional context (dates, zip codes, etc.)

  // Audit trail
  ip_address String?
  user_agent String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([stripe_session_id])
  @@index([transaction_type])
  @@index([status])
  @@index([created_at])
}

model AppleTransactionClaim {
  id                   String          @id @default(cuid())
  apple_transaction_id String          @unique
  transaction_type     TransactionType
  user_id              String?
  order_id             String?
  ad_id                String?
  metadata             Json?
  claimed_at           DateTime        @default(now())

  @@index([transaction_type])
  @@index([user_id])
  @@index([order_id])
  @@index([ad_id])
  @@index([claimed_at])
}

model ProcessedStripeEvent {
  id                    String    @id @default(cuid())
  event_id              String    @unique
  event_type            String
  processed             Boolean   @default(false)
  processing_started_at DateTime?
  processed_at          DateTime?
  last_error            String?
  created_at            DateTime  @default(now())

  @@index([created_at])
  @@index([processed])
}

// ===========================
// Admin Activity Log
// ===========================

model AdminActivityLog {
  id          String   @id @default(cuid())
  admin_id    String
  admin_email String
  action      String // e.g., "Ban User", "Delete Team", "Approve Ad"
  target_type String // e.g., "user", "team", "ad", "post"
  target_id   String // ID of the affected resource
  description String // Human-readable description
  metadata    Json? // Additional context (old values, new values, etc.)
  timestamp   DateTime @default(now())

  @@index([admin_id])
  @@index([target_type])
  @@index([target_id])
  @@index([timestamp])
}

// ===========================
// Abuse Reports
// ===========================

model AbuseReport {
  id              String    @id @default(cuid())
  reporter_id     String? // User who submitted the report
  reporter_name   String
  reporter_email  String
  subject         String
  message         String    @db.Text
  status          String    @default("pending") // "pending", "reviewed", "resolved", "dismissed"
  reviewed_by     String? // Admin ID who reviewed
  reviewed_at     DateTime?
  resolution_note String?   @db.Text // Admin notes about resolution
  created_at      DateTime  @default(now())

  // Structured report target (2026-07-16). Content reports used to encode the
  // target only as `[type:id]` inside `subject` and as a JSON blob inside
  // `message`, so de-duping was an app-layer read-then-write race and strike
  // counting was a `LIKE '%...%'` full scan. These columns make both a real
  // indexed query with a DB-enforced uniqueness guarantee.
  //
  // Nullable on purpose: pre-2026-07-16 rows keep NULLs and are NOT backfilled.
  // Postgres treats NULLs as distinct in a unique index, so historical rows can
  // never collide — and, deliberately, they do not feed the strike ladder. A
  // brand-new auto-punishment system must not retroactively ban people the
  // moment it deploys; the ladder starts from zero at deploy time.
  target_type    String? // post | user | comment | message | group_chat_message | team | ad
  target_id      String? // id of the reported entity
  target_user_id String? // author/owner of the reported entity (the strike subject)

  reporter User? @relation(fields: [reporter_id], references: [id], onDelete: SetNull)

  // De-dupe guard: at most ONE report per (reporter, target). Without this a
  // single user could stack every rung of the strike ladder alone.
  @@unique([reporter_id, target_type, target_id])
  @@index([reporter_id])
  @@index([status])
  @@index([created_at])
  @@index([target_user_id])
  @@index([target_type, target_id])
}

// ===========================
// User Warnings / Strikes
// ===========================

model UserWarning {
  id           String    @id @default(cuid())
  user_id      String
  issued_by    String?
  reason       String    @db.Text
  severity     String    @default("warning") // warning | strike | final_warning
  report_id    String? // Link to the report that triggered this
  expires_at   DateTime? // Null = permanent
  acknowledged Boolean   @default(false)
  created_at   DateTime  @default(now())

  // Strike-ladder provenance (2026-07-16). Set ONLY by the automatic ladder in
  // lib/moderation.ts, which mints at most one strike per offending piece of
  // content. Admin-issued warnings/bans leave these NULL.
  //
  // The unique index is the ladder's idempotency guard: re-processing the same
  // report (retry, concurrent reports crossing the threshold together) can
  // never double-strike, because the second insert loses on P2002.
  //
  // It is also what makes the ladder position countable without ambiguity:
  // `count(source_type != NULL)` is the rung, unaffected by admin actions —
  // so an admin warning can never silently push someone toward an auto-ban.
  source_type String? // 'post' | 'comment' | 'message' | ...
  source_id   String? // id of the content that earned the strike

  user   User  @relation("warned_user", fields: [user_id], references: [id], onDelete: Cascade)
  issuer User? @relation("warning_issuer", fields: [issued_by], references: [id], onDelete: SetNull)

  @@unique([source_type, source_id])
  @@index([user_id])
  @@index([user_id, created_at])
  @@index([severity])
  @@index([user_id, source_type])
}
