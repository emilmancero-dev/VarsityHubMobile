{
  "name": "varsityhub-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && rm -f .tsbuildinfo && tsc -p . && mkdir -p dist/shared && (cp ../shared/plan-definitions.json dist/shared/ 2>/dev/null || cp ./shared/plan-definitions.json dist/shared/ 2>/dev/null || (echo '❌ ERROR: plan-definitions.json not found' && exit 1)) && echo '✅ Build successful'",
    "start": "node dist/index.js",
    "postinstall": "npx prisma generate",
    "railway:deploy": "npx prisma generate && npm run build",
    "postdeploy": "npx prisma migrate deploy && npm run seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "verify:email": "tsx scripts/verify-email-config.ts",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@prisma/client": "^5.22.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^7.91.0",
    "@sentry/profiling-node": "^7.91.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "bullmq": "^5.66.5",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "expo": "~54.0.25",
    "expo-apple-authentication": "~8.0.7",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.11",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.1",
    "rate-limit-redis": "^4.3.1",
    "react": "19.1.0",
    "react-native": "0.84.0",
    "react-native-google-places-autocomplete": "^2.5.7",
    "react-native-maps": "1.20.1",
    "stripe": "^16.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^4.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.1",
    "@types/react-native-maps": "^0.24.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.16.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
