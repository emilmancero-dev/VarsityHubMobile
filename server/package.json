{
  "name": "varsityhub-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && rm -f .tsbuildinfo && tsc -p . && mkdir -p dist/shared && (cp ../shared/plan-definitions.json dist/shared/ 2>/dev/null || cp ./shared/plan-definitions.json dist/shared/ 2>/dev/null || (echo '❌ ERROR: plan-definitions.json not found' && exit 1)) && (cp ../docs/well-known/assetlinks.json ./well-known/assetlinks.json 2>/dev/null || true) && echo '✅ Build successful'",
    "start": "node dist/index.js",
    "postinstall": "npx prisma generate",
    "railway:deploy": "npx prisma generate && npm run build",
    "postdeploy": "npx prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:invariants": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --runTestsByPath src/__tests__/coach-flow-invariants.test.ts src/__tests__/oauth-account-linking.test.ts && npx tsx scripts/verify-session-enforcement.ts",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:payments:confidence": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runTestsByPath src/__tests__/distributedLock.test.ts src/__tests__/transaction-logger-update.test.ts src/__tests__/payments-finalization.test.ts src/__tests__/google-play-unverified-fallback.test.ts",
    "verify:email": "tsx scripts/verify-email-config.ts",
    "verify:email-go-live": "tsx scripts/verify-email-go-live.ts",
    "verify:production-health": "tsx scripts/verify-production-health.ts",
    "verify:auth-canary": "tsx scripts/verify-auth-canary.ts",
    "verify:app-review": "tsx scripts/verify-app-review-account.ts",
    "verify:coach-flow": "tsx scripts/verify-coach-flow.ts",
    "verify:event-approval-flow": "tsx scripts/verify-event-approval-flow.ts",
    "verify:ad-approval-flow": "tsx scripts/verify-ad-approval-flow.ts",
    "verify:ad-dashboard-review-flow": "tsx scripts/verify-ad-dashboard-review-flow.ts",
    "verify:coach-route-battery": "tsx scripts/verify-coach-route-battery.ts",
    "verify:org-manager-access": "tsx scripts/verify-org-manager-access.ts",
    "verify:rate-limits": "tsx scripts/verify-rate-limit-coverage.ts",
    "verify:cloudinary": "tsx scripts/verify-cloudinary.ts",
    "verify:coach-approval": "tsx scripts/verify-coach-approval.ts",
    "verify:access-matrix": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runTestsByPath src/__tests__/access-matrix.test.ts --runInBand",
    "verify:backup-freshness": "tsx scripts/verify-backup-freshness.ts",
    "prepare:app-review": "tsx scripts/create-demo-account.ts",
    "prepare:coach:uat": "tsx scripts/prepare-coach-uat-accounts.ts",
    "audit:prod": "npm audit --omit=dev",
    "load:smoke": "tsx scripts/load/p0-load-smoke.ts",
    "load:validate-lock": "tsx scripts/load/validate-distributed-lock.ts",
    "lint": "expo lint"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-rekognition": "^3.1032.0",
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^7.91.0",
    "@sentry/profiling-node": "^7.91.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/opossum": "^8.1.9",
    "@varsityhub/shared": "file:../shared",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "opossum": "^8.5.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.1",
    "prisma": "5.22.0",
    "rate-limit-redis": "^4.3.1",
    "sanitize-html": "2.17.5",
    "socket.io": "^4.8.3",
    "stripe": "^16.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^4.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": "5.11.1",
    "undici": "^6.28.0",
    "postcss": "8.5.25",
    "axios": "^1.19.0",
    "brace-expansion": "5.0.9",
    "qs": "6.16.0",
    "follow-redirects": ">=1.15.12",
    "js-yaml": "^4.3.2",
    "fast-uri": "^4.1.4",
    "socket.io-parser": "^4.2.7"
  }
}
