# Never upload local dotenv files to EAS builds — app.config.js reads process.env
# at build time, so a stale local .env (e.g. EXPO_PUBLIC_USE_LOCAL_API=1) could
# otherwise bake localhost into a production binary. Build env comes from eas.json.
