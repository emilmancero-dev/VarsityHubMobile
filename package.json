  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "react-native-iap",
          "lottie-ios",
          "react-native-compressor"
        ],
        "listUnknownPackages": false
      },
      "appConfigFieldsNotSyncedCheck": {
