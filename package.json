{
  "name": "varsityhubmobile",
  "main": "expo-router/entry",
  "version": "1.0.5",
  "scripts": {
    "start": "expo start",
    "predev": "lsof -ti:8081 | xargs kill -9 2>/dev/null || true; lsof -ti:4000 | xargs kill -9 2>/dev/null || true",
    "dev": "concurrently --kill-others-on-fail -n app,server -c green,cyan \"npm run dev:expo\" \"npm run server:dev\"",
    "dev:expo": "expo start --dev-client --scheme varsityhubmobile --host localhost --port 8081 --clear",
    "dev:local": "expo start --dev-client --scheme varsityhubmobile --host localhost --port 8081",
    "dev:server": "bash scripts/start-dev-server.sh",
    "dev:xcode": "bash scripts/build-dev-client-xcode.sh",
    "dev:ios": "cross-env EXPO_PUBLIC_API_URL=http://localhost:4000 EXPO_PUBLIC_FORCE_REMOTE_API=0 EXPO_PUBLIC_USE_LOCAL_API=1 EXPO_PUBLIC_NODE_ENV=development expo run:ios --device",
    "web:deploy:prod": "bash scripts/deploy-web-static.sh",
    "reset-project": "bash scripts/clean-repo-artifacts.sh",
    "android": "cross-env EXPO_PUBLIC_API_URL=http://localhost:4000 EXPO_PUBLIC_FORCE_REMOTE_API=0 EXPO_PUBLIC_USE_LOCAL_API=1 EXPO_PUBLIC_NODE_ENV=development expo run:android",
    "ios": "cross-env EXPO_PUBLIC_API_URL=http://localhost:4000 EXPO_PUBLIC_FORCE_REMOTE_API=0 EXPO_PUBLIC_USE_LOCAL_API=1 EXPO_PUBLIC_NODE_ENV=development expo run:ios",
    "web": "expo start --web",
    "diagnose:metro": "bash scripts/diagnose-metro.sh",
    "diagnose:env": "node scripts/check-env-alignment.js",
    "web:playwright": "cross-env CI=1 NODE_OPTIONS=--max-old-space-size=8192 RCT_METRO_PORT=8081 EXPO_PUBLIC_API_URL=http://localhost:4000 EXPO_PUBLIC_FORCE_REMOTE_API=0 EXPO_PUBLIC_NODE_ENV=development expo start --web --non-interactive",
    "web:playwright:ci": "cross-env CI=1 NODE_OPTIONS=--max-old-space-size=8192 RCT_METRO_PORT=8081 EXPO_PUBLIC_API_URL=http://localhost:4000 EXPO_PUBLIC_FORCE_REMOTE_API=0 EXPO_PUBLIC_NODE_ENV=development expo start --web --port 8081",
    "start:ci": "cross-env CI=1 expo start --port 19001",
    "web:ci": "cross-env CI=1 expo start --web --port 9500",
    "android:ci": "cross-env CI=1 expo start --android --port 19002",
    "postinstall": "node ./scripts/apply-patches.js && node ./tools/ensure-simple-swizzle.js && node ./tools/ensure-debug-index.js && node ./tools/patches/patch-router-sitemap.js && node ./tools/ensure-is-arrayish.js && node ./tools/patches/patch-logbox-button.js && node ./tools/patches/patch-expo-updates-bouncycastle.js && node ./scripts/patch-lottie-ios.js && node ./scripts/ensure-server-prisma-client.js",
    "fix:deps": "node ./tools/ensure-simple-swizzle.js && node ./tools/ensure-debug-index.js && node ./tools/ensure-is-arrayish.js",
    "lint": "expo lint",
    "format:check": "bash scripts/format-check-changed.sh",
    "format:check:all": "npx prettier --check \"app/**/*.{ts,tsx,js,jsx}\" \"components/**/*.{ts,tsx,js,jsx}\" \"hooks/**/*.{ts,tsx,js,jsx}\" \"utils/**/*.{ts,tsx,js,jsx}\" \"apiclient/**/*.{ts,tsx,js,jsx}\" \"context/**/*.{ts,tsx,js,jsx}\" \"constants/**/*.{ts,tsx,js,jsx}\" \"server/src/**/*.{ts,tsx,js,jsx}\" \"*.{js,json,md}\" \"docs/**/*.md\"",
    "lint:strict": "expo lint --fix && npm run typecheck",
    "doctor": "npx expo-doctor",
    "coach:uat:baseline": "bash scripts/run-coach-uat-baseline.sh",
    "coach:uat:prepare": "npm --prefix server run prepare:coach:uat",
    "validate:pre-launch": "bash scripts/validate-pre-launch.sh",
    "release:verify:local": "bash scripts/release-workflow.sh local",
    "release:verify:build": "bash scripts/release-workflow.sh build",
    "release:verify:runtime": "bash scripts/release-workflow.sh runtime",
    "release:verify:full": "bash scripts/release-workflow.sh full",
    "release:workflow": "bash scripts/release-workflow.sh full",
    "build:production": "bash scripts/build-production.sh",
    "build:ios": "bash scripts/build-safe.sh ios",
    "build:android": "bash scripts/build-safe.sh android",
    "build:safe": "bash scripts/build-safe.sh",
    "verify:build": "bash scripts/verify-build-ready.sh",
    "verify:play-submit-access": "node scripts/verify-play-service-account.js",
    "verify:play-store": "bash scripts/verify-play-store-readiness.sh",
    "verify:release": "bash scripts/verify-release-readiness.sh",
    "verify:async-handlers": "node scripts/check-async-handler-usage.js",
    "verify:error-envelope": "node scripts/check-error-envelope-usage.js",
    "verify:user-cache": "node scripts/check-user-cache-invalidation.js",
    "verify:secrets": "node scripts/check-secret-literals.js",
    "verify:guardrails": "bash scripts/verify-guardrails.sh",
    "verify:confidence": "bash scripts/verify-confidence.sh",
    "verify:production-ready": "bash scripts/verify-production-ready.sh",
    "test:build": "bash scripts/test-build-config.sh",
    "audit:app": "bash scripts/comprehensive-app-audit.sh",
    "audit:pre-release": "bash scripts/pre-release-audit.sh",
    "audit:navigation": "bash scripts/audit-navigation.sh",
    "audit:navigation:fail": "bash scripts/audit-navigation.sh --fail",
    "audit:structural-duplicates": "node scripts/check-structural-duplicates.js",
    "dev:rebuild": "bash scripts/ensure-latest-dev-client.sh",
    "verify:version": "bash scripts/verify-latest-version.sh",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "update:production": "node scripts/guard-ota-clean-tree.js && cross-env SENTRY_DISABLE_AUTO_UPLOAD= eas update --branch production",
    "server:install": "cd server && npm install",
    "server:dev": "cd server && npm run dev",
    "server:db:migrate": "cd server && npx prisma migrate dev --name init",
    "server:db:seed": "cd server && npm run seed",
    "server:db:studio": "cd server && npx prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:regressions:client": "jest --runInBand utils/__tests__/notificationPresentation.test.ts utils/__tests__/userDisplay.test.ts apiclient/__tests__/upload-routing.test.ts components/__tests__/EventMap.test.ts app/game-details/__tests__/GameVerticalFeedScreen.nav.test.tsx __tests__/onboarding-step2-media.test.tsx app/__tests__/route-integrity.test.ts utils/__tests__/coachApprovalFlow.test.ts 'app/\\(tabs\\)/__tests__/team-hub.test.tsx' app/__tests__/navigation-guards.test.ts",
    "test:regressions:server": "npm --prefix server test -- --runInBand src/__tests__/requireOnboarded-bypass.test.ts src/__tests__/middleware-coverage.test.ts src/__tests__/geofencing-post-grace-window.test.ts src/__tests__/games-cache-invalidation.test.ts src/__tests__/games-approval-race.test.ts src/__tests__/users-follow-cache-invalidation.test.ts src/__tests__/apple-notification-dedup.test.ts src/__tests__/ad-approval-race.test.ts src/__tests__/team-invite-race-guards.test.ts",
    "ci:retry": "node scripts/run-with-retry.js",
    "test:repeat": "node scripts/repeat-command.js",
    "test:regressions:server:repeat": "node scripts/repeat-command.js 10 npm run test:regressions:server",
    "test:regressions": "npm run test:regressions:client && npm run test:regressions:server",
    "test:api": "npm run test:server",
    "test:e2e": "npm run test:smoke",
    "test:server": "npm --prefix server test",
    "verify:p0:foundation": "npm audit --omit=dev && npm --prefix server audit --omit=dev && npm --prefix server run verify:rate-limits && npm --prefix server run test:payments:confidence",
    "test:smoke:managed": "playwright test",
    "test:smoke": "bash scripts/test-smoke-stable.sh",
    "test:cloudinary": "bash scripts/test-cloudinary-uploads.sh",
    "test:smoke:ui": "playwright test --ui",
    "test:smoke:headed": "playwright test --headed",
    "test:smoke:debug": "playwright test --debug",
    "test:coverage": "jest --coverage --runInBand",
    "stash:apply": "bash scripts/safe-stash-apply.sh",
    "check:conflicts": "rg -l \"^<<<<<<< |^>>>>>>> |^=======$\" --glob \"*.ts\" --glob \"*.tsx\" --glob \"*.js\" app components hooks utils api context constants lib shared server/src 2>/dev/null && echo \"Conflicts found!\" || echo \"No conflicts found.\"",
    "format": "npx prettier --write \"app/**/*.{ts,tsx,js,jsx}\" \"components/**/*.{ts,tsx,js,jsx}\" \"hooks/**/*.{ts,tsx,js,jsx}\" \"utils/**/*.{ts,tsx,js,jsx}\" \"apiclient/**/*.{ts,tsx,js,jsx}\" \"context/**/*.{ts,tsx,js,jsx}\" \"constants/**/*.{ts,tsx,js,jsx}\" \"__tests__/**/*.{ts,tsx}\" \"server/src/**/*.{ts,tsx,js,jsx}\" \"*.{js,json,md}\" \"docs/**/*.md\"",
    "audit:duplication": "npx --yes jscpd@3.5.10 --config .jscpd.json"
  },
