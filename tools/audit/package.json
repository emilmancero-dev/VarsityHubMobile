{
  "name": "@varsityhub/audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "test": "tsx --test tests/*.test.ts ../../scripts/audit-check.test.ts",
    "test:ui": "playwright test",
    "audit": "tsx ../../scripts/audit-check.ts --root ../..",
    "artifacts": "tsx scripts/generate-artifacts.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76",
    "@radix-ui/react-checkbox": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "vite": "^6.4.0",
    "typescript": "~5.9.2",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.55.0"
  }
}
