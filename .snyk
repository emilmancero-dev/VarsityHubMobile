# Snyk Policy File (.snyk)
# Supports: version, ignore, patch
# Documentation: https://docs.snyk.io/snyk-cli/test-for-vulnerabilities/the-.snyk-file

version: v1.29.0

# Exclude non-production paths from Snyk Code SAST scanning
exclude:
  code:
    - server/scripts
    - server/mock-server.js
    - server/src/__tests__
    - server/tests
    - tests

ignore:
  # ─── Transitive dependency vulnerabilities (no direct fix available) ───

  SNYK-JS-WS-17988732:
    - '*':
        reason: 'Allocation-of-resources DoS in ws (fixed 8.21.1). The high-severity path is ws@7.5.11, transitive via react-native@0.81.5 > react-devtools-core > ws — dev/debug tooling only, never in the release bundle. The server also resolves ws@8.21.0 (one patch behind the fix) transitively via socket.io; a direct bump means regenerating the root lockfile, which must stay npm@11-generated for the Railway Docker build (project constraint) — deferring that until the next lockfile refresh rather than doing it in a test/CI-only change. Time-boxed acceptance.'
        expires: '2026-09-30T23:59:59Z'

  # ─── Base-image npm CLI tooling (node:20-bookworm-slim ships npm@10.8.2) ───
  # All transitive deps of the npm CLI in the base image; build-time only,
  # not run at container runtime. The container scan already reports the APP
  # dependency layers clean — these are base tooling, fixed by a base-image
  # bump (tracked separately), not app code.
  SNYK-JS-BRACEEXPANSION-15789759:
    - '*':
        reason: 'npm@10.8.2 CLI tooling bundled in the node:20-bookworm-slim base image (build-time only; the server runs node, never npm, at container runtime). --exclude-base-image-vulns drops OS/apt packages, not the bundled npm node_modules. Real fix is a base-image digest bump (Dockerfile/Railway deploy change, tracked separately). Time-boxed acceptance.'
        expires: '2026-09-30T23:59:59Z'
  SNYK-JS-BRACEEXPANSION-17706650:
    - '*':
        reason: 'npm@10.8.2 CLI tooling bundled in the node:20-bookworm-slim base image (build-time only; the server runs node, never npm, at container runtime). --exclude-base-image-vulns drops OS/apt packages, not the bundled npm node_modules. Real fix is a base-image digest bump (Dockerfile/Railway deploy change, tracked separately). Time-boxed acceptance.'
        expires: '2026-09-30T23:59:59Z'
