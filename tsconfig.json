{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    // Skip lib check for faster compilation
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/api/*": ["apiclient/*"],
      "@/components/*": ["components/*"],
      "@/constants/*": ["constants/*"],
      "@/hooks/*": ["hooks/*"],
      "@/context/*": ["context/*"],
      "@/utils/*": ["utils/*"],
      "@/config/*": ["config/*"],
      "@/data/*": ["data/*"],
      "@/ui/*": ["components/ui/*"],
      "@/styles/*": ["styles/*"],
      "@/features/*": ["app/features/*"],
      "@/shared/*": ["shared/*"],
      "@/lib/*": ["lib/*"],
      "react-native-calendars": ["types/react-native-calendars.d.ts"]
    },
    "resolveJsonModule": true,
    "types": ["node", "react", "react-native", "jest"]
  },
  "include": [
    "shared/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "api/**/*.ts",
    "api/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "constants/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "jest.setup.ts",
    "types/**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
