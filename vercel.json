{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web && node scripts/relocate-web-vendor-assets.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "(git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git rev-parse --verify HEAD^ >/dev/null 2>&1 && git diff --quiet HEAD^ HEAD -- ':!server/' ':!.github/' ':!ios/' ':!android/') || exit 1",
  "redirects": [
    {
      "source": "/((?!\\.well-known/).*)",
      "has": [{ "type": "host", "value": "varsityhub.app" }],
      "destination": "https://www.varsityhub.app/$1",
      "permanent": true
    },
    {
      "source": "/events/:id",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/public-event?id=:id",
      "permanent": false
    },
    {
      "source": "/games/:id",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/game-detail?id=:id",
      "permanent": false
    },
    {
      "source": "/posts/:id",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/post-detail?id=:id",
      "permanent": false
    },
    {
      "source": "/teams/:id",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/team-page?id=:id",
      "permanent": false
    },
    {
      "source": "/users/:id",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/user-profile?id=:id",
      "permanent": false
    },
    {
      "source": "/programs/:id",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/program-page?id=:id",
      "permanent": false
    },
    { "source": "/join/org", "destination": "/organization-invites", "permanent": false },
    { "source": "/join/team", "destination": "/team-invites", "permanent": false },
    {
      "source": "/share",
      "has": [{ "type": "query", "key": "type", "value": "post" }],
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/post-detail",
      "permanent": false
    },
    {
      "source": "/share",
      "has": [{ "type": "query", "key": "type", "value": "game" }],
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/game-detail",
      "permanent": false
    },
    {
      "source": "/share",
      "has": [{ "type": "query", "key": "type", "value": "event" }],
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/public-event",
      "permanent": false
    },
    {
      "source": "/share",
      "has": [{ "type": "query", "key": "type", "value": "team" }],
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/team-page",
      "permanent": false
    },
    {
      "source": "/share",
      "has": [{ "type": "query", "key": "type", "value": "profile" }],
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/user-profile",
      "permanent": false
    },
    {
      "source": "/share",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/organizations/:id", "destination": "/organizations/[id]" },
    {
      "source": "/share",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "https://api-production-8ac3.up.railway.app/share"
    },
    {
      "source": "/events/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "https://api-production-8ac3.up.railway.app/og/events/:id"
    },
    {
      "source": "/games/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "https://api-production-8ac3.up.railway.app/og/games/:id"
    },
    {
      "source": "/posts/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "https://api-production-8ac3.up.railway.app/posts/:id"
    },
    {
      "source": "/teams/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "https://api-production-8ac3.up.railway.app/teams/:id"
    },
    {
      "source": "/users/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "https://api-production-8ac3.up.railway.app/users/:id"
    },
    {
      "source": "/programs/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
      "destination": "https://api-production-8ac3.up.railway.app/programs/:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
